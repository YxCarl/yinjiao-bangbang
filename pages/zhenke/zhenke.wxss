.page-container { padding: 32rpx 32rpx 80rpx; }

.page-header { margin-bottom: 24rpx; }
.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-1);
  display: block;
  letter-spacing: 2rpx;
}
.page-sub {
  font-size: 24rpx;
  color: var(--text-3);
  margin-top: 6rpx;
  letter-spacing: 1rpx;
}

/* 上传 */
.upload-area {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 320rpx;
  border: 2rpx dashed rgba(74, 144, 226, 0.3);
  background: linear-gradient(180deg, #FFFFFF 0%, #EAF2FB 100%);
}
.upload-area:active { background: var(--primary-soft); }
.upload-placeholder, .video-preview { text-align: center; width: 100%; }
.upload-badge {
  width: 92rpx;
  height: 92rpx;
  border-radius: 20rpx;
  font-size: 36rpx;
  font-family: 'STSong','SimSun',serif;
  margin: 0 auto 20rpx;
}
.upload-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-1);
  margin-bottom: 6rpx;
}
.upload-desc { font-size: 22rpx; color: var(--text-3); }

.mock-player {
  background: #1F3D5C;
  color: #FFF;
  width: 100%;
  height: 240rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
  margin-bottom: 16rpx;
}
.mock-player::before {
  content: '▶ ';
  color: var(--accent);
  margin-right: 12rpx;
  font-size: 32rpx;
}
.file-reupload {
  font-size: 22rpx;
  color: var(--text-3);
  text-decoration: underline;
}

/* AI 卡片 */
.ai-card { padding: 32rpx; }
.ai-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}
.ai-label { font-size: 28rpx; font-weight: 600; color: var(--text-1); }
.ai-status-pill {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-weight: 500;
}
.ai-idle { background: #F0F2F7; color: var(--text-3); }
.ai-loading { background: var(--primary-light); color: var(--primary); }
.ai-done { background: #E5F4EC; color: var(--success); }

.ai-progress {
  height: 6rpx;
  background: var(--divider);
  border-radius: 3rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
  position: relative;
}
.ai-loading-bar {
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, transparent 0%, var(--primary) 50%, transparent 100%);
  animation: loading-slide 1.6s linear infinite;
}
@keyframes loading-slide {
  0% { transform: translateX(-100%); }
  100% { transform: translateX(100%); }
}

.ai-empty {
  font-size: 24rpx;
  color: var(--text-3);
  line-height: 1.6;
  padding-top: 8rpx;
}

.ai-timeline {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0 4rpx;
  border-top: 1rpx dashed var(--divider);
  padding-top: 24rpx;
}
.time-node { flex: 1; display: flex; flex-direction: column; align-items: center; }
.t-time-pill {
  font-size: 22rpx;
  color: var(--primary);
  background: var(--primary-light);
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
  font-weight: 600;
}
.node-label {
  font-size: 24rpx;
  color: var(--text-2);
  margin-top: 12rpx;
  font-weight: 500;
}

.tip-row { margin: 24rpx 4rpx 0; }
.tip-text {
  font-size: 22rpx;
  color: var(--text-3);
  line-height: 1.5;
}

.submit-btn {
  margin-top: 48rpx;
  font-size: 30rpx;
  padding: 28rpx 0;
}

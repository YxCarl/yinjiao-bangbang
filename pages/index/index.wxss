.page-container { padding: 0 32rpx 120rpx; }

/* ========== 顶部 ========== */
.top-bar {
  padding: 32rpx 0 24rpx;
  background: transparent;
  margin-bottom: 24rpx;
}
.brand-row {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}
.brand-mini {
  position: relative;
  width: 64rpx;
  height: 64rpx;
  margin-right: 16rpx;
}
.bm-shape {
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, #2D5683 0%, #1F3D5C 100%);
  border-radius: 14rpx;
  transform: rotate(-6deg);
}
.bm-char {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #FFF;
  font-weight: 700;
  font-family: 'STSong', 'SimSun', serif;
}
.brand-text-wrap { display: flex; flex-direction: column; flex: 1; }
.brand-title { font-size: 32rpx; font-weight: 700; color: var(--text-1); letter-spacing: 2rpx; }
.brand-slogan { font-size: 22rpx; color: var(--text-3); margin-top: 4rpx; letter-spacing: 1rpx; }

.msg-btn {
  position: relative;
  font-size: 26rpx;
  color: var(--text-2);
  padding: 12rpx 22rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  border: 1rpx solid var(--border);
}
.msg-dot {
  position: absolute;
  top: 8rpx;
  right: 14rpx;
  width: 12rpx;
  height: 12rpx;
  background: var(--danger);
  border-radius: 50%;
  border: 2rpx solid #FFF;
}

/* 搜索栏 */
.search-bar {
  background: #FFFFFF;
  height: 76rpx;
  border-radius: 38rpx;
  display: flex;
  align-items: center;
  padding: 0 28rpx;
  border: 1rpx solid var(--border);
  box-shadow: 0 4rpx 12rpx rgba(29, 54, 88, 0.04);
}
.s-icon {
  font-size: 30rpx;
  color: var(--primary);
  margin-right: 14rpx;
  font-weight: bold;
}
.search-placeholder { font-size: 26rpx; color: var(--text-3); }

/* ========== 数据看板 ========== */
.dashboard-card {
  margin-bottom: 32rpx;
  background: linear-gradient(135deg, #2D5683 0%, #1F3D5C 100%);
  color: #FFFFFF;
  border: none;
  position: relative;
  overflow: hidden;
  box-shadow: 0 12rpx 32rpx rgba(45, 86, 131, 0.18);
}
.dashboard-card::before {
  content: '';
  position: absolute;
  top: -120rpx;
  right: -120rpx;
  width: 320rpx;
  height: 320rpx;
  background: radial-gradient(circle, rgba(200, 146, 78, 0.16) 0%, transparent 70%);
  border-radius: 50%;
}
.dash-greeting { display: flex; flex-direction: column; margin-bottom: 32rpx; }
.hello { font-size: 36rpx; font-weight: 600; color: #FFFFFF; letter-spacing: 1rpx; }
.hello-sub { font-size: 24rpx; color: rgba(255,255,255,0.7); margin-top: 6rpx; }

.dash-data {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}
.data-item { flex: 1; display: flex; flex-direction: column; align-items: flex-start; }
.d-val { font-size: 48rpx; font-weight: 700; color: #FFFFFF; letter-spacing: 1rpx; }
.d-unit { font-size: 22rpx; color: rgba(255,255,255,0.7); font-weight: 400; margin-left: 4rpx; }
.d-label { font-size: 24rpx; color: rgba(255,255,255,0.7); margin-top: 4rpx; }
.d-divider { width: 1rpx; height: 60rpx; background: rgba(255,255,255,0.18); margin: 0 24rpx; }

.progress-track {
  height: 8rpx;
  background: rgba(255,255,255,0.18);
  border-radius: 4rpx;
  margin-bottom: 32rpx;
  overflow: hidden;
}
.progress-bar {
  height: 100%;
  background: linear-gradient(90deg, #D9A663 0%, #C8924E 100%);
  border-radius: 4rpx;
  transition: width 0.5s;
}
.progress-tip {
  font-size: 22rpx;
  color: rgba(255,255,255,0.45);
  text-align: center;
  display: block;
  margin-bottom: 24rpx;
}

.dash-actions { display: flex; }
.dash-actions .btn-primary {
  background: rgba(255,255,255,0.16);
  color: #FFFFFF;
  box-shadow: none;
  border: 1rpx solid rgba(255,255,255,0.2);
}
.dash-actions .btn-outline {
  background: transparent;
  color: #FFFFFF;
  border: 1rpx solid rgba(255,255,255,0.4);
}
.space-w { width: 24rpx; }

/* ========== Banner ========== */
.banner-swiper {
  height: 180rpx;
  margin-bottom: 16rpx;
}
.banner-card {
  background: linear-gradient(135deg, #FFFFFF 0%, #FBF3E5 100%);
  border-radius: 16rpx;
  padding: 28rpx;
  margin: 0 4rpx;
  height: 100%;
  position: relative;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(200, 146, 78, 0.12);
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.bnr-tag {
  display: inline-block;
  align-self: flex-start;
  font-size: 22rpx;
  color: var(--accent-dark);
  background: rgba(200, 146, 78, 0.15);
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
  margin-bottom: 12rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
}
.bnr-title { font-size: 30rpx; font-weight: 600; color: var(--text-1); margin-bottom: 8rpx; }
.bnr-sub { font-size: 24rpx; color: var(--text-2); }
.bnr-deco {
  position: absolute;
  right: -50rpx;
  top: -40rpx;
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(circle, rgba(200, 146, 78, 0.18) 0%, transparent 70%);
  border-radius: 50%;
}

.bnr-indicator {
  display: flex;
  justify-content: center;
  gap: 8rpx;
  margin-bottom: 32rpx;
}
.bnr-dot {
  width: 12rpx;
  height: 6rpx;
  background: var(--text-4);
  border-radius: 3rpx;
  transition: all 0.2s;
}
.bnr-dot-on {
  width: 24rpx;
  background: var(--primary);
}

/* ========== 核心业务 ========== */
.service-grid { display: flex; flex-direction: column; gap: 20rpx; margin-bottom: 32rpx; }
.s-card { display: flex; align-items: center; padding: 28rpx 24rpx; }
.s-card:active { background: var(--primary-soft); }
.s-badge { width: 80rpx; height: 80rpx; border-radius: 16rpx; font-size: 32rpx; font-family: 'STSong','SimSun',serif; }
.s-text { flex: 1; margin-left: 24rpx; display: flex; flex-direction: column; }
.s-name { font-size: 32rpx; font-weight: 600; color: var(--text-1); margin-bottom: 6rpx; }
.s-en { font-size: 24rpx; color: var(--text-3); }
.s-arrow { font-size: 40rpx; color: var(--text-4); font-weight: 200; }

/* ========== 学习资源 ========== */
.resource-row {
  display: flex;
  align-items: center;
  padding: 32rpx 0;
  margin-bottom: 32rpx;
}
.res-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.res-item:active { opacity: 0.7; }
.res-divider { width: 1rpx; height: 80rpx; background: var(--divider); }
.res-badge { width: 64rpx; height: 64rpx; border-radius: 12rpx; font-size: 28rpx; margin-bottom: 12rpx; }
.res-name { font-size: 28rpx; font-weight: 500; color: var(--text-1); margin-bottom: 4rpx; }
.res-sub { font-size: 22rpx; color: var(--text-3); }

/* ========== 名师推荐 ========== */
.tutor-list { display: flex; flex-direction: column; gap: 20rpx; }
.tutor-card { display: flex; align-items: flex-start; padding: 28rpx 24rpx; }
.tutor-card:active { background: var(--primary-soft); }
.avatar-badge { width: 88rpx; height: 88rpx; border-radius: 50%; font-size: 34rpx; flex-shrink: 0; font-family: 'STSong','SimSun',serif; }
.t-info { flex: 1; margin-left: 20rpx; min-width: 0; }
.t-name-row { display: flex; align-items: center; gap: 12rpx; margin-bottom: 6rpx; }
.t-name { font-size: 30rpx; font-weight: 600; color: var(--text-1); }
.t-title { font-size: 24rpx; color: var(--text-3); display: block; margin-bottom: 12rpx; }
.t-desc {
  font-size: 24rpx;
  color: var(--text-2);
  line-height: 1.5;
  background: var(--primary-soft);
  padding: 12rpx 16rpx;
  border-radius: 8rpx;
}
.t-stat {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  margin-left: 16rpx;
  flex-shrink: 0;
}
.t-rate { font-size: 26rpx; font-weight: 600; color: var(--accent); margin-bottom: 6rpx; }
.t-orders { font-size: 22rpx; color: var(--text-3); }

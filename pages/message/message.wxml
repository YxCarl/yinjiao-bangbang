<view class="page-container">
  <view class="page-header">
    <text class="page-title">消息中心</text>
    <text class="page-sub">仅展示云端已授权会话</text>
  </view>

  <view class="msg-list">
    <view class="empty-tip" wx:if="{{loadError}}">会话加载失败，请重新进入此页重试</view>
    <view class="empty-tip" wx:if="{{listLimited}}">历史会话过多，当前列表可能不完整；请联系部署者清理失效记录</view>
    <view class="empty-tip" wx:if="{{conversations.length === 0 && !loadError && !listLimited}}">暂无云端会话</view>
    <view class="biz-card msg-item" wx:for="{{conversations}}" wx:key="id" bindtap="openItem" data-id="{{item.id}}">
      <view class="text-badge msg-icon {{item.theme}}">{{item.char}}</view>
      <view class="msg-content">
        <view class="msg-top">
          <text class="msg-name">{{item.name}}</text>
          <text class="msg-time">{{item.time}}</text>
        </view>
        <text class="msg-preview">{{item.preview}}</text>
      </view>
      <view class="unread-badge" wx:if="{{item.unread > 0}}">{{item.unread}}</view>
    </view>
  </view>
</view>

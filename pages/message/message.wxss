.page-container { padding: 32rpx 32rpx 80rpx; min-height: 100vh; }

.page-header { margin-bottom: 24rpx; }
.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-1);
  display: block;
  letter-spacing: 2rpx;
}
.page-sub {
  font-size: 24rpx;
  color: var(--text-3);
  margin-top: 6rpx;
  letter-spacing: 1rpx;
}

.msg-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.msg-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  position: relative;
}
.msg-item:active { background: var(--primary-soft); }

.msg-icon {
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  font-size: 34rpx;
  margin-right: 22rpx;
  flex-shrink: 0;
  font-family: 'STSong','SimSun',serif;
}

.msg-content { flex: 1; min-width: 0; }
.msg-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 6rpx;
}
.msg-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-1);
}
.msg-time {
  font-size: 22rpx;
  color: var(--text-3);
  flex-shrink: 0;
  margin-left: 12rpx;
}
.msg-preview {
  font-size: 24rpx;
  color: var(--text-2);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  display: block;
  line-height: 1.5;
}

.unread-badge {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  min-width: 32rpx;
  height: 32rpx;
  background: var(--danger);
  color: #FFF;
  border-radius: 16rpx;
  font-size: 20rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 10rpx;
  border: 2rpx solid #FFF;
}

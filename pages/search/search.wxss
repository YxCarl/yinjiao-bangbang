.page-container { padding: 24rpx 32rpx 60rpx; min-height: 100vh; }

/* 搜索头 */
.search-header {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
}
.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  height: 76rpx;
  padding: 0 28rpx;
  background: #FFFFFF;
  border: 1rpx solid var(--border);
  border-radius: 38rpx;
  box-shadow: 0 4rpx 12rpx rgba(29,54,88,0.04);
}
.s-icon {
  font-size: 30rpx;
  color: var(--primary);
  margin-right: 14rpx;
  font-weight: 700;
}
.s-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-1);
}
.ph-color { color: var(--text-4); }
.clear-input {
  font-size: 32rpx;
  color: var(--text-4);
  padding: 4rpx 12rpx;
}
.cancel-text {
  font-size: 28rpx;
  color: var(--primary);
  font-weight: 500;
  margin-left: 24rpx;
}

/* Section */
.search-section { margin-bottom: 8rpx; }
.sec-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}
.sec-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-1);
}
.clear-btn {
  font-size: 22rpx;
  color: var(--text-3);
  padding: 4rpx 8rpx;
}
.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.tag-chip {
  background: #FFFFFF;
  color: var(--text-2);
  padding: 12rpx 24rpx;
  border-radius: 24rpx;
  font-size: 26rpx;
  border: 1rpx solid var(--border);
}
.tag-chip:active { background: var(--primary-soft); }
.hot-chip {
  background: var(--accent-light);
  color: var(--accent-dark);
  border: 1rpx solid rgba(200, 146, 78, 0.2);
}
.hot-rank {
  display: inline-block;
  width: 28rpx;
  height: 28rpx;
  border-radius: 6rpx;
  background: var(--accent);
  color: #FFF;
  font-size: 20rpx;
  font-weight: 700;
  text-align: center;
  line-height: 28rpx;
  margin-right: 6rpx;
}

/* 结果 */
.result-header { margin-bottom: 16rpx; }
.result-title { font-size: 24rpx; color: var(--text-3); }
.hl { color: var(--accent); font-weight: 600; }

.result-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.result-card { display: flex; padding: 24rpx; }
.result-card:active { background: var(--primary-soft); }
.r-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 18rpx;
  font-size: 32rpx;
  flex-shrink: 0;
  font-family: 'STSong','SimSun',serif;
}
.r-info {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}
.r-name-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-bottom: 8rpx;
  flex-wrap: wrap;
}
.r-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-1);
}
.r-title {
  font-size: 22rpx;
  color: var(--text-3);
}
.r-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 8rpx;
}
.r-desc {
  font-size: 24rpx;
  color: var(--text-2);
  line-height: 1.5;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}
.empty-mark {
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  background: var(--primary-light);
  color: var(--primary);
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  font-family: 'STSong','SimSun',serif;
}
.empty-title {
  font-size: 28rpx;
  color: var(--text-1);
  font-weight: 600;
  margin-bottom: 8rpx;
}
.empty-sub {
  font-size: 22rpx;
  color: var(--text-3);
}

.page-container { padding: 32rpx 32rpx 80rpx; }

.page-header { margin-bottom: 24rpx; }
.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-1);
  display: block;
  letter-spacing: 2rpx;
}
.page-sub {
  font-size: 24rpx;
  color: var(--text-3);
  margin-top: 6rpx;
  letter-spacing: 1rpx;
}

/* 头像卡 */
.avatar-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx;
}
.p-avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 30rpx;
  font-size: 56rpx;
  font-family: 'STSong','SimSun',serif;
  margin-bottom: 16rpx;
}
.edit-tips {
  font-size: 22rpx;
  color: var(--text-3);
}

/* 表单 */
.form-card { padding: 8rpx 32rpx; }
.form-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--divider);
}
.form-item:last-child { border-bottom: none; }
.label {
  font-size: 28rpx;
  color: var(--text-1);
  font-weight: 500;
  flex-shrink: 0;
  width: 180rpx;
}
.input-field {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-1);
  text-align: right;
}
.text-right { text-align: right; }
.ph-color { color: var(--text-4); }
.picker-value {
  font-size: 28rpx;
  color: var(--text-3);
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex: 1;
  justify-content: flex-end;
}
.picker-value.selected { color: var(--primary); font-weight: 600; }
.arrow { color: var(--text-4); font-size: 30rpx; }

.readonly-card {
  margin-top: 16rpx;
  padding: 8rpx 32rpx;
}
.readonly-val {
  font-size: 26rpx;
  color: var(--text-3);
  letter-spacing: 1rpx;
  font-variant-numeric: tabular-nums;
}

.submit-btn {
  margin-top: 48rpx;
  font-size: 30rpx;
  padding: 28rpx 0;
}

.page-container {
  background: #F5F6FA;
  min-height: 100vh;
  padding-bottom: 60rpx;
}

/* 顶部信息栏 */
.teacher-header {
  background: linear-gradient(135deg, #1F3D5C 0%, #2D5683 60%, #3868A0 100%);
  padding: 60rpx 32rpx 80rpx;
  color: #FFF;
  position: relative;
  overflow: hidden;
}
.header-bg-deco {
  position: absolute;
  top: -100rpx;
  right: -100rpx;
  width: 400rpx;
  height: 400rpx;
  background: radial-gradient(circle, rgba(200, 146, 78, 0.22) 0%, transparent 70%);
  pointer-events: none;
}

.t-header-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
  position: relative;
  z-index: 2;
}
.exit-btn {
  font-size: 26rpx;
  color: rgba(255,255,255,0.85);
  padding: 6rpx 0;
}
.t-page-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
  letter-spacing: 2rpx;
}
.t-stats-mini { display: flex; align-items: center; }
.rate-num {
  font-size: 26rpx;
  color: #F5C885;
  font-weight: 600;
}

.greeting-row {
  display: flex;
  align-items: center;
  margin-bottom: 36rpx;
  position: relative;
  z-index: 2;
}
.t-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  font-size: 40rpx;
  margin-right: 24rpx;
  border: 4rpx solid rgba(255,255,255,0.18);
  font-family: 'STSong', 'SimSun', serif;
}
.greeting { display: flex; flex-direction: column; }
.t-name {
  font-size: 38rpx;
  font-weight: 600;
  margin-bottom: 6rpx;
  letter-spacing: 1rpx;
}
.t-title {
  font-size: 24rpx;
  color: rgba(255,255,255,0.7);
  letter-spacing: 1rpx;
}

.income-row {
  display: flex;
  align-items: center;
  background: rgba(255,255,255,0.1);
  border: 1rpx solid rgba(255,255,255,0.16);
  backdrop-filter: blur(10px);
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  position: relative;
  z-index: 2;
}
.income-block { flex: 1; display: flex; flex-direction: column; }
.income-label {
  font-size: 22rpx;
  color: rgba(255,255,255,0.65);
  margin-bottom: 4rpx;
}
.income-num {
  font-size: 38rpx;
  font-weight: 700;
  color: #F5C885;
  letter-spacing: 1rpx;
  font-variant-numeric: tabular-nums;
}
.income-divider {
  width: 1rpx;
  height: 60rpx;
  background: rgba(255,255,255,0.18);
  margin: 0 24rpx;
}
.btn-withdraw {
  background: linear-gradient(135deg, #D9A663 0%, #C8924E 100%);
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 600;
  padding: 14rpx 28rpx;
  border-radius: 24rpx;
  margin-left: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(200, 146, 78, 0.3);
}
.btn-withdraw:active { opacity: 0.85; }

/* 快捷数据 */
.quick-stats {
  display: flex;
  gap: 16rpx;
  padding: 0 32rpx;
  margin-top: -50rpx;
  position: relative;
  z-index: 3;
  margin-bottom: 32rpx;
}
.stat-card {
  flex: 1;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(29, 54, 88, 0.06);
}
.qs-num {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--primary);
  margin-bottom: 4rpx;
}
.qs-label {
  font-size: 22rpx;
  color: var(--text-3);
}

/* 标签栏 */
.tab-nav {
  display: flex;
  background: #FFFFFF;
  margin: 0 32rpx 24rpx;
  padding: 0 16rpx;
  border-radius: 12rpx;
  border: 1rpx solid var(--border);
}
.tab-item {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: var(--text-2);
  padding: 24rpx 0;
  position: relative;
  font-weight: 500;
}
.tab-item.active { color: var(--primary); font-weight: 700; }
.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 8rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 4rpx;
  background: var(--accent);
  border-radius: 2rpx;
}

/* 订单列表 */
.order-list { padding: 0 32rpx; display: flex; flex-direction: column; gap: 20rpx; }
.order-card { padding: 28rpx; }
.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}
.order-time { font-size: 22rpx; color: var(--text-3); }
.order-body {
  border-bottom: 1rpx dashed var(--divider);
  padding-bottom: 20rpx;
  margin-bottom: 20rpx;
}
.course-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-1);
  display: block;
  margin-bottom: 12rpx;
  line-height: 1.4;
}
.course-desc {
  font-size: 26rpx;
  color: var(--text-2);
  line-height: 1.5;
}

.order-footer { display: flex; justify-content: space-between; align-items: center; }
.bounty-box {
  display: flex;
  align-items: baseline;
  color: var(--accent-dark);
}
.rmb { font-size: 24rpx; font-weight: 600; margin-right: 4rpx; }
.bounty-num {
  font-size: 40rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}
.file-indicator {
  font-size: 22rpx;
  color: var(--accent-dark);
  background: var(--accent-light);
  padding: 8rpx 14rpx;
  border-radius: 6rpx;
  display: inline-block;
  margin-top: 8rpx;
}
.btn-grab {
  font-size: 26rpx;
  font-weight: 600;
  padding: 14rpx 32rpx;
  border-radius: 24rpx;
  letter-spacing: 1rpx;
}

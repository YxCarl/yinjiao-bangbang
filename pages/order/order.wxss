.page-container {
  background-color: #F5F6FA;
  min-height: 100vh;
  padding: 32rpx 32rpx 60rpx;
}

.page-header {
  margin-bottom: 24rpx;
}
.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-1);
  display: block;
  letter-spacing: 2rpx;
}
.page-sub {
  font-size: 24rpx;
  color: var(--text-3);
  margin-top: 6rpx;
  letter-spacing: 1rpx;
}

/* 标签栏 */
.tab-nav {
  display: flex;
  background: #FFFFFF;
  padding: 6rpx;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--border);
}
.tab-item {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-2);
  padding: 18rpx 0;
  border-radius: 8rpx;
  transition: all 0.18s;
  font-weight: 500;
}
.tab-item.active {
  background: var(--primary);
  color: #FFFFFF;
  font-weight: 600;
  box-shadow: 0 4rpx 10rpx rgba(45, 86, 131, 0.18);
}

/* 订单列表 */
.order-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.order-card { padding: 28rpx; }

.order-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  gap: 16rpx;
}
.order-status { font-size: 24rpx; font-weight: 500; }
.status-doing { color: var(--primary); }
.status-done { color: var(--text-3); }
.status-wait { color: var(--warning); }

.order-body {
  border-bottom: 1rpx dashed var(--divider);
  padding-bottom: 20rpx;
  margin-bottom: 20rpx;
}
.course-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-1);
  display: block;
  margin-bottom: 12rpx;
  line-height: 1.4;
}
.teacher-info {
  font-size: 22rpx;
  color: var(--text-2);
  background: var(--primary-soft);
  padding: 8rpx 14rpx;
  border-radius: 6rpx;
  display: inline-block;
}

.order-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.bounty-box {
  display: flex;
  align-items: baseline;
  color: var(--text-1);
}
.rmb { font-size: 22rpx; margin-right: 6rpx; color: var(--text-2); }
.bounty-num {
  font-size: 38rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  color: var(--accent-dark);
}
.btn-action {
  font-size: 26rpx;
  padding: 14rpx 28rpx;
  border-radius: 24rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}
.empty-mark {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: var(--primary-light);
  color: var(--primary);
  font-size: 36rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  font-family: 'STSong', 'SimSun', serif;
}
.empty-title {
  font-size: 30rpx;
  color: var(--text-1);
  font-weight: 600;
  margin-bottom: 8rpx;
}
.empty-sub {
  font-size: 24rpx;
  color: var(--text-3);
  margin-bottom: 32rpx;
  text-align: center;
  padding: 0 60rpx;
  line-height: 1.5;
}
.empty-btn {
  padding: 18rpx 56rpx;
  font-size: 26rpx;
}

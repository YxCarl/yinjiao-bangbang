.page-container { padding: 32rpx 32rpx 80rpx; }

.page-header { margin-bottom: 24rpx; }
.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-1);
  display: block;
  letter-spacing: 2rpx;
}
.page-sub {
  font-size: 24rpx;
  color: var(--text-3);
  margin-top: 6rpx;
  letter-spacing: 1rpx;
}

/* 上传区 */
.upload-area {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 300rpx;
  border: 2rpx dashed rgba(45, 86, 131, 0.25);
  background: linear-gradient(180deg, #FFFFFF 0%, #F4F7FB 100%);
}
.upload-area:active { background: var(--primary-soft); }
.upload-placeholder, .file-ready { text-align: center; }
.upload-badge {
  width: 92rpx;
  height: 92rpx;
  border-radius: 20rpx;
  font-size: 36rpx;
  font-family: 'STSong','SimSun',serif;
  margin: 0 auto 20rpx;
}
.upload-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-1);
  margin-bottom: 6rpx;
}
.upload-desc { font-size: 22rpx; color: var(--text-3); }
.file-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--primary);
  margin-bottom: 8rpx;
  word-break: break-all;
  padding: 0 24rpx;
}
.file-reupload {
  font-size: 22rpx;
  color: var(--text-3);
  text-decoration: underline;
}

/* 表单卡片 */
.form-card { padding: 8rpx 32rpx; }
.form-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 0;
  border-bottom: 1rpx solid var(--divider);
}
.form-item:last-child { border-bottom: none; }
.label {
  font-size: 28rpx;
  color: var(--text-1);
  font-weight: 500;
  flex-shrink: 0;
}
.picker-value {
  font-size: 28rpx;
  color: var(--text-3);
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.picker-value.selected { color: var(--primary); font-weight: 600; }
.picker-value.disabled { color: var(--text-4); }
.arrow { color: var(--text-4); font-size: 30rpx; }

.price-input-wrap {
  display: flex;
  align-items: center;
}
.price-prefix {
  font-size: 30rpx;
  color: var(--accent-dark);
  font-weight: 600;
  margin-right: 6rpx;
}
.price-input {
  text-align: right;
  font-size: 32rpx;
  color: var(--accent-dark);
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}
.ph-color { color: var(--text-4); font-weight: 400; font-size: 26rpx; }

/* 提示 */
.tip-row {
  margin: 24rpx 4rpx 0;
}
.tip-text {
  font-size: 22rpx;
  color: var(--text-3);
  line-height: 1.5;
}

.submit-btn {
  margin-top: 48rpx;
  font-size: 30rpx;
  padding: 28rpx 0;
}

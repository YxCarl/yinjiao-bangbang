<view class="page-container mentor-page-pad">

  <!-- 顶部个人信息 -->
  <view class="mine-header">
    <view class="header-bg-deco"></view>

    <view class="mh-top">
      <view class="mh-avatar badge-accent">{{profile.avatar || '师'}}</view>
      <view class="mh-info">
        <text class="mh-name">{{profile.name}}</text>
        <text class="mh-title">{{profile.title}}{{profile.subject ? ' · ' + profile.subject : ''}}</text>
        <text class="mh-meta">{{profile.years ? profile.years + '年教龄' : '教龄待完善'}} ｜ ID: {{profile.id}}</text>
      </view>
      <view class="mh-edit" bindtap="goEdit">
        <text>编辑</text>
      </view>
    </view>

    <!-- 接单状态开关 -->
    <view class="online-toggle" bindtap="toggleOnline">
      <view class="ot-label">
        <text class="ot-dot {{onlineStatus ? 'dot-on' : 'dot-off'}}"></text>
        <text>接单状态</text>
      </view>
      <view class="ot-switch {{onlineStatus ? 'sw-on' : 'sw-off'}}">
        <view class="ot-knob"></view>
      </view>
      <text class="ot-tip">{{onlineStatus ? '在线接单中' : '已下线休息'}}</text>
    </view>
  </view>

  <!-- 收益卡片 -->
  <view class="income-section">
    <view class="income-card">
      <view class="ic-row">
        <view class="ic-item">
          <text class="ic-num accent">¥{{balance}}</text>
          <text class="ic-label">可提现余额</text>
        </view>
        <view class="ic-divider"></view>
        <view class="ic-item">
          <text class="ic-num">¥{{todayIncome}}</text>
          <text class="ic-label">今日收益</text>
        </view>
        <view class="ic-divider"></view>
        <view class="ic-item">
          <text class="ic-num">¥{{totalIncome}}</text>
          <text class="ic-label">累计收益</text>
        </view>
      </view>
      <view class="ic-actions">
        <view class="btn-withdraw" bindtap="doWithdraw">立即提现</view>
        <view class="btn-detail" bindtap="showIncome">收益明细</view>
      </view>
    </view>
  </view>

  <!-- 数据概览 -->
  <view class="stats-row">
    <view class="stat-item" bindtap="showIncome">
      <text class="si-num">{{totalOrders}}</text>
      <text class="si-label">累计指导</text>
    </view>
    <view class="stat-item" bindtap="showReviews">
      <text class="si-num">★ {{profile.rating}}</text>
      <text class="si-label">学员评分</text>
    </view>
    <view class="stat-item">
      <text class="si-num">{{completionRate}}%</text>
      <text class="si-label">完成率</text>
    </view>
    <view class="stat-item">
      <text class="si-num">{{totalOrders > 0 ? '118' : '0'}}</text>
      <text class="si-label">好评数</text>
    </view>
  </view>

  <!-- 功能列表 -->
  <view class="func-list">
    <view class="func-item" bindtap="showCert">
      <view class="fi-left">
        <view class="fi-icon badge-info">证</view>
        <text class="fi-text">名师认证</text>
      </view>
      <view class="fi-right">
        <text class="fi-tag tag-ok" wx:if="{{certified}}">已认证</text>
        <text class="fi-arrow">›</text>
      </view>
    </view>
    <view class="func-item" bindtap="showSchedule">
      <view class="fi-left">
        <view class="fi-icon badge-success">排</view>
        <text class="fi-text">排班设置</text>
      </view>
      <view class="fi-right">
        <text class="fi-arrow">›</text>
      </view>
    </view>
    <view class="func-item" bindtap="showReviews">
      <view class="fi-left">
        <view class="fi-icon badge-accent">评</view>
        <text class="fi-text">学员评价</text>
      </view>
      <view class="fi-right">
        <text class="fi-arrow">›</text>
      </view>
    </view>
    <view class="func-item" bindtap="showHelp">
      <view class="fi-left">
        <view class="fi-icon badge-ink">指</view>
        <text class="fi-text">导师指引</text>
      </view>
      <view class="fi-right">
        <text class="fi-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 退出登录 -->
  <view class="logout-section">
    <view class="btn-logout" bindtap="doLogout">退出登录</view>
  </view>

  <!-- 底部导航 -->
  <view class="mentor-tabbar">
    <view class="mentor-tab" bindtap="navHome">
      <view class="mt-icon">工</view>
      <text class="mt-label">工作台</text>
    </view>
    <view class="mentor-tab" bindtap="navMsg">
      <view class="mt-icon">信</view>
      <view class="mt-badge" wx:if="{{msgUnread > 0}}">{{msgUnread}}</view>
      <text class="mt-label">消息</text>
    </view>
    <view class="mentor-tab mt-active">
      <view class="mt-icon">我</view>
      <text class="mt-label">我的</text>
    </view>
  </view>
</view>

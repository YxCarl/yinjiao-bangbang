.page-container {
  background: #F5F6FA;
  min-height: 100vh;
  padding-bottom: 60rpx;
}

/* 顶部个人信息 */
.mine-header {
  background: linear-gradient(135deg, #1F3D5C 0%, #2D5683 60%, #3868A0 100%);
  padding: 60rpx 32rpx 40rpx;
  position: relative;
  overflow: hidden;
}
.header-bg-deco {
  position: absolute;
  top: -80rpx;
  right: -80rpx;
  width: 360rpx;
  height: 360rpx;
  background: radial-gradient(circle, rgba(200, 146, 78, 0.18) 0%, transparent 70%);
  pointer-events: none;
}

.mh-top {
  display: flex;
  align-items: center;
  position: relative;
  z-index: 2;
  margin-bottom: 32rpx;
}
.mh-avatar {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  font-size: 44rpx;
  font-weight: 600;
  color: #FFF;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid rgba(255,255,255,0.2);
  margin-right: 24rpx;
  font-family: 'STSong', 'SimSun', serif;
}
.mh-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.mh-name {
  font-size: 38rpx;
  font-weight: 700;
  color: #FFF;
  margin-bottom: 6rpx;
}
.mh-title {
  font-size: 24rpx;
  color: rgba(255,255,255,0.75);
  margin-bottom: 6rpx;
}
.mh-meta {
  font-size: 22rpx;
  color: rgba(255,255,255,0.5);
}
.mh-edit {
  padding: 10rpx 24rpx;
  border: 2rpx solid rgba(255,255,255,0.35);
  border-radius: 20rpx;
  font-size: 24rpx;
  color: rgba(255,255,255,0.85);
  position: relative;
  z-index: 2;
}
.mh-edit:active { background: rgba(255,255,255,0.1); }

/* 接单状态开关 */
.online-toggle {
  display: flex;
  align-items: center;
  background: rgba(255,255,255,0.1);
  border: 1rpx solid rgba(255,255,255,0.14);
  border-radius: 14rpx;
  padding: 20rpx 24rpx;
  position: relative;
  z-index: 2;
}
.ot-label {
  display: flex;
  align-items: center;
  flex: 1;
  font-size: 26rpx;
  color: rgba(255,255,255,0.85);
}
.ot-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 12rpx;
}
.dot-on { background: #5DE8A0; box-shadow: 0 0 10rpx rgba(93,232,160,0.5); }
.dot-off { background: #FF8A80; }
.ot-switch {
  width: 80rpx;
  height: 44rpx;
  border-radius: 22rpx;
  padding: 4rpx;
  margin-right: 16rpx;
  transition: background 0.2s;
  display: flex;
  align-items: center;
}
.sw-on { background: #C8924E; justify-content: flex-end; }
.sw-off { background: rgba(255,255,255,0.25); justify-content: flex-start; }
.ot-knob {
  width: 36rpx;
  height: 36rpx;
  background: #FFF;
  border-radius: 50%;
  box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.15);
}
.ot-tip {
  font-size: 22rpx;
  color: rgba(255,255,255,0.55);
}

/* 收益卡片 */
.income-section {
  padding: 0 32rpx;
  margin-top: -28rpx;
  position: relative;
  z-index: 3;
}
.income-card {
  background: #FFF;
  border-radius: 18rpx;
  padding: 32rpx 28rpx 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(29, 54, 88, 0.08);
}
.ic-row {
  display: flex;
  align-items: center;
  margin-bottom: 28rpx;
}
.ic-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.ic-num {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--primary);
  margin-bottom: 6rpx;
}
.ic-num.accent {
  color: var(--accent-dark);
  font-size: 38rpx;
}
.ic-label {
  font-size: 22rpx;
  color: var(--text-3);
}
.ic-divider {
  width: 1rpx;
  height: 56rpx;
  background: var(--divider);
}
.ic-actions {
  display: flex;
  gap: 16rpx;
}
.btn-withdraw {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 12rpx;
  background: linear-gradient(135deg, #D9A663 0%, #C8924E 100%);
  color: #FFF;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(200, 146, 78, 0.25);
}
.btn-withdraw:active { opacity: 0.85; }
.btn-detail {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 12rpx;
  background: var(--primary-light);
  color: var(--primary);
  font-size: 28rpx;
  font-weight: 600;
}
.btn-detail:active { opacity: 0.7; }

/* 数据概览 */
.stats-row {
  display: flex;
  margin: 24rpx 32rpx;
  background: #FFF;
  border-radius: 16rpx;
  padding: 28rpx 0;
  box-shadow: 0 2rpx 12rpx rgba(29, 54, 88, 0.04);
}
.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}
.stat-item::after {
  content: '';
  position: absolute;
  right: 0;
  top: 8rpx;
  bottom: 8rpx;
  width: 1rpx;
  background: var(--divider);
}
.stat-item:last-child::after { display: none; }
.si-num {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-1);
  margin-bottom: 6rpx;
}
.si-label {
  font-size: 22rpx;
  color: var(--text-3);
}

/* 功能列表 */
.func-list {
  margin: 0 32rpx 32rpx;
  background: #FFF;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(29, 54, 88, 0.04);
  overflow: hidden;
}
.func-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 28rpx;
  border-bottom: 1rpx solid var(--divider);
}
.func-item:last-child { border-bottom: none; }
.func-item:active { background: var(--primary-soft); }
.fi-left {
  display: flex;
  align-items: center;
}
.fi-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #FFF;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}
.fi-text {
  font-size: 30rpx;
  color: var(--text-1);
  font-weight: 500;
}
.fi-right {
  display: flex;
  align-items: center;
}
.fi-tag {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  margin-right: 12rpx;
}
.tag-ok { background: #E5F4EC; color: var(--success); }
.fi-arrow {
  font-size: 36rpx;
  color: var(--text-4);
  font-weight: 300;
}

/* 退出登录 */
.logout-section {
  padding: 0 32rpx 32rpx;
}
.btn-logout {
  text-align: center;
  padding: 28rpx 0;
  border-radius: 16rpx;
  background: #FFF;
  color: var(--danger);
  font-size: 30rpx;
  font-weight: 500;
  border: 1rpx solid rgba(209, 64, 64, 0.15);
}
.btn-logout:active { background: #FFF5F5; }

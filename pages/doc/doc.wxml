<view class="page-container">

  <block wx:if="{{doc}}">
    <view class="doc-header biz-card">
      <view class="text-badge doc-icon badge-accent">案</view>
      <text class="d-title">{{doc.title}}</text>
      <view class="d-tags">
        <text class="chip chip-accent" wx:for="{{doc.tags}}" wx:key="*this" wx:for-item="t">{{t}}</text>
      </view>
      <text class="d-desc">{{doc.desc}}</text>
    </view>

    <view class="biz-card mt-24" wx:if="{{doc.chapters && doc.chapters.length}}">
      <view class="section-title">资料目录</view>
      <view class="content-row" wx:for="{{doc.chapters}}" wx:key="index">
        <view class="text-badge cr-num badge-primary">{{index + 1}}</view>
        <text class="cr-text">{{item}}</text>
      </view>
    </view>

    <view class="biz-card mt-24" style="margin-bottom: 220rpx;">
      <view class="section-title">资料说明</view>
      <view class="endorse-row">
        <view class="text-badge endorse-avatar badge-primary">示</view>
        <view class="endorse-meta">
          <text class="endorse-name">开源示例资料</text>
          <text class="endorse-text">页面内容仅用于说明数据结构，不构成真实教师推荐。</text>
        </view>
      </view>
    </view>
  </block>

  <view class="empty-tip" wx:elif="{{!loading}}">
    资料加载失败，请稍后重试
  </view>

  <view class="bottom-bar">
    <view class="btn-biz btn-outline flex-1" bindtap="saveDoc">收藏未开放</view>
    <view class="btn-biz btn-primary flex-1" bindtap="downloadDoc">{{doc && doc.fileID ? '下载资料' : '暂无文件'}}</view>
  </view>
</view>

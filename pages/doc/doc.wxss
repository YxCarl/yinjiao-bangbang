.page-container { padding: 32rpx 32rpx 60rpx; }

.doc-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 32rpx;
  text-align: center;
  background: linear-gradient(135deg, #FFFFFF 0%, #FBF3E5 100%);
  border: 1rpx solid rgba(200, 146, 78, 0.2);
}
.doc-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 24rpx;
  font-size: 48rpx;
  margin-bottom: 24rpx;
  font-family: 'STSong','SimSun',serif;
}
.d-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-1);
  margin-bottom: 16rpx;
  letter-spacing: 1rpx;
}
.d-tags {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
}
.d-desc {
  font-size: 24rpx;
  color: var(--text-2);
  line-height: 1.7;
  text-align: left;
}

/* 内容行 */
.content-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx dashed var(--divider);
}
.content-row:last-child { border-bottom: none; padding-bottom: 0; }
.cr-num {
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.cr-text {
  font-size: 26rpx;
  color: var(--text-1);
  font-weight: 500;
}

/* 导师背书 */
.endorse-row {
  display: flex;
  align-items: center;
  background: var(--primary-soft);
  padding: 20rpx;
  border-radius: 12rpx;
}
.endorse-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  font-size: 32rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
  font-family: 'STSong','SimSun',serif;
}
.endorse-meta { display: flex; flex-direction: column; }
.endorse-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-1);
  margin-bottom: 4rpx;
}
.endorse-text {
  font-size: 24rpx;
  color: var(--text-2);
  font-style: italic;
}

/* 底部 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  border-top: 1rpx solid var(--border);
  gap: 20rpx;
  z-index: 100;
}
.bottom-bar .btn-biz {
  font-size: 28rpx;
  padding: 22rpx 0;
}

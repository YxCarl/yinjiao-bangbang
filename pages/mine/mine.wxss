.page-container {
  padding: 0 32rpx 80rpx;
  position: relative;
  min-height: 100vh;
}

/* 头部装饰背景 */
.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 360rpx;
  background: linear-gradient(180deg, #2D5683 0%, #3868A0 100%);
  z-index: 0;
}
.header-bg::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: radial-gradient(ellipse at top right, rgba(200, 146, 78, 0.18), transparent 60%);
}

/* 个人资料卡片 */
.profile-card {
  position: relative;
  z-index: 2;
  margin-top: 80rpx;
  padding: 32rpx;
}
.p-top { display: flex; align-items: center; }
.user-avatar {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  font-size: 44rpx;
  font-family: 'STSong', 'SimSun', serif;
  flex-shrink: 0;
}
.p-info {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.p-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 6rpx;
}
.p-name {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-1);
}
.role-pill {
  font-size: 20rpx;
  background: var(--primary-light);
  color: var(--primary);
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
}
.role-pill-mentor {
  background: var(--accent-light);
  color: var(--accent-dark);
}
.p-role {
  font-size: 24rpx;
  color: var(--text-3);
  margin-bottom: 4rpx;
}
.p-id {
  font-size: 22rpx;
  color: var(--text-4);
  letter-spacing: 1rpx;
}
.btn-edit {
  font-size: 24rpx;
  color: var(--primary);
  border: 1rpx solid var(--primary);
  border-radius: 24rpx;
  padding: 8rpx 22rpx;
  flex-shrink: 0;
  margin-left: 12rpx;
}
.btn-edit:active { background: var(--primary-light); }

/* 数据统计 */
.stats-card {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 32rpx 0;
  margin-top: 24rpx;
}
.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.stat-item:active { opacity: 0.6; }
.s-num {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-1);
  margin-bottom: 4rpx;
  letter-spacing: 1rpx;
}
.s-label {
  font-size: 22rpx;
  color: var(--text-3);
}
.stat-line {
  width: 1rpx;
  height: 50rpx;
  background: var(--divider);
}

/* 区块标题 */
.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-2);
  margin: 32rpx 0 16rpx;
  display: flex;
  align-items: center;
  letter-spacing: 1rpx;
}
.section-title::before {
  content: '';
  display: inline-block;
  width: 4rpx;
  height: 22rpx;
  background: var(--primary);
  border-radius: 2rpx;
  margin-right: 12rpx;
}

/* 列表卡片 */
.list-card {
  padding: 0 28rpx;
}
.list-row {
  padding: 28rpx 0;
}
.l-left { display: flex; align-items: center; }
.l-right { display: flex; align-items: center; gap: 12rpx; }
.list-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  margin-right: 20rpx;
  font-family: 'STSong', 'SimSun', serif;
}
.l-text {
  font-size: 28rpx;
  color: var(--text-1);
  font-weight: 500;
}
.l-tip {
  font-size: 24rpx;
  color: var(--text-3);
}
.l-arrow {
  font-size: 36rpx;
  color: var(--text-4);
  font-weight: 200;
  font-family: monospace;
}

/* 切换工作台卡片 */
.switch-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  background: linear-gradient(135deg, #FFFFFF 0%, #FBF3E5 100%);
  border: 1rpx solid rgba(200, 146, 78, 0.2);
}
.switch-card:active { opacity: 0.85; }
.switch-left { display: flex; align-items: center; }
.switch-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-family: 'STSong', 'SimSun', serif;
  margin-right: 20rpx;
}
.switch-meta { display: flex; flex-direction: column; }
.switch-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-1);
  margin-bottom: 4rpx;
}
.switch-sub {
  font-size: 22rpx;
  color: var(--accent-dark);
}

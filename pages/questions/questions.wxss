.page-container { padding: 32rpx 32rpx 60rpx; min-height: 100vh; }

.page-header { margin-bottom: 24rpx; }
.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-1);
  display: block;
  letter-spacing: 2rpx;
}
.page-sub {
  font-size: 24rpx;
  color: var(--text-3);
  margin-top: 6rpx;
  letter-spacing: 1rpx;
}

/* 标签 */
.tab-nav {
  display: flex;
  background: #FFFFFF;
  padding: 6rpx;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--border);
}
.tab-item {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-2);
  padding: 18rpx 0;
  border-radius: 8rpx;
  font-weight: 500;
}
.tab-item.active {
  background: var(--primary);
  color: #FFF;
  font-weight: 600;
  box-shadow: 0 4rpx 10rpx rgba(45,86,131,0.18);
}

/* 列表 */
.qa-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.qa-card { padding: 28rpx; }

.q-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1rpx dashed var(--divider);
  padding-bottom: 20rpx;
  margin-bottom: 20rpx;
}
.q-time { font-size: 22rpx; color: var(--text-3); }

.q-body {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20rpx;
}
.q-icon {
  width: 44rpx;
  height: 44rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  margin-right: 14rpx;
  flex-shrink: 0;
  margin-top: 2rpx;
  font-family: 'STSong','SimSun',serif;
}
.q-text {
  font-size: 28rpx;
  color: var(--text-1);
  line-height: 1.6;
}

.a-body {
  background: var(--primary-soft);
  padding: 20rpx;
  border-radius: 12rpx;
  border-left: 4rpx solid var(--primary);
}
.a-tag {
  font-size: 22rpx;
  color: var(--text-2);
  margin-bottom: 12rpx;
  font-weight: 500;
}
.audio-box {
  background: linear-gradient(135deg, #2D5683 0%, #1F3D5C 100%);
  display: inline-flex;
  align-items: center;
  gap: 16rpx;
  padding: 14rpx 24rpx;
  border-radius: 32rpx;
  color: #FFF;
  min-width: 200rpx;
  box-shadow: 0 4rpx 12rpx rgba(45,86,131,0.18);
}
.audio-wave {
  display: flex;
  align-items: center;
  gap: 4rpx;
}
.wave-bar {
  width: 4rpx;
  height: 18rpx;
  background: rgba(255,255,255,0.85);
  border-radius: 2rpx;
  animation: wave-pulse 1.2s ease-in-out infinite;
}
.wave-bar-2 { height: 26rpx; animation-delay: 0.2s; }
.wave-bar-3 { height: 14rpx; animation-delay: 0.4s; }
@keyframes wave-pulse {
  0%, 100% { transform: scaleY(0.6); }
  50% { transform: scaleY(1.3); }
}
.audio-time { font-size: 24rpx; }

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}
.empty-mark {
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  background: var(--primary-light);
  color: var(--primary);
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  font-family: 'STSong','SimSun',serif;
}
.empty-title {
  font-size: 28rpx;
  color: var(--text-1);
  font-weight: 600;
  margin-bottom: 24rpx;
}
.empty-btn {
  padding: 18rpx 56rpx;
  font-size: 26rpx;
}

.page-container { padding: 32rpx 32rpx 80rpx; }

.page-header { margin-bottom: 24rpx; }
.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-1);
  display: block;
  letter-spacing: 2rpx;
}
.page-sub {
  font-size: 24rpx;
  color: var(--text-3);
  margin-top: 6rpx;
  letter-spacing: 1rpx;
}

/* 提示卡 */
.header-tips {
  display: flex;
  align-items: flex-start;
  background: linear-gradient(135deg, #FFFFFF 0%, #FBF3E5 100%);
  border: 1rpx solid rgba(200, 146, 78, 0.2);
}
.tip-badge {
  width: 64rpx;
  height: 64rpx;
  border-radius: 14rpx;
  font-size: 28rpx;
  font-family: 'STSong','SimSun',serif;
  flex-shrink: 0;
}
.tip-content {
  flex: 1;
  margin-left: 20rpx;
  font-size: 26rpx;
  color: var(--text-2);
  line-height: 1.6;
}

/* 文本域 */
.question-input {
  width: 100%;
  height: 320rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--text-1);
}
.word-count {
  text-align: right;
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 12rpx;
}
.ph-color { color: var(--text-4); }

/* 选项 */
.option-list { padding: 8rpx 32rpx; }
.option-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
}
.opt-left { display: flex; flex-direction: column; }
.opt-title {
  font-size: 28rpx;
  color: var(--text-1);
  font-weight: 500;
  margin-bottom: 4rpx;
}
.opt-desc {
  font-size: 22rpx;
  color: var(--text-3);
}

/* 价格 */
.price-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: var(--primary-soft);
  padding: 24rpx 28rpx;
  border-radius: 12rpx;
  margin-top: 32rpx;
  border: 1rpx solid var(--border);
}
.price-label {
  font-size: 26rpx;
  color: var(--text-2);
}
.price-detail {
  display: flex;
  align-items: baseline;
  color: var(--accent-dark);
}
.price-symbol { font-size: 22rpx; font-weight: 600; }
.price-num {
  font-size: 38rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  margin: 0 4rpx;
}
.price-unit { font-size: 22rpx; color: var(--text-3); }

.submit-btn {
  margin-top: 32rpx;
  font-size: 30rpx;
  padding: 28rpx 0;
}

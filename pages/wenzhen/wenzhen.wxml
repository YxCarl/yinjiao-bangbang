<view class="page-container">

<view class="page-header">
  <text class="page-title">问诊室</text>
  <text class="page-sub">职场困惑 · 银龄经验解惑</text>
</view>

<view class="header-tips biz-card">
  <view class="text-badge tip-badge badge-accent">问</view>
  <text class="tip-content">请详细描述您的困惑；本参考实现不保证导师接单或回复时间。</text>
</view>

<view class="biz-card mt-24">
  <textarea class="question-input"
            placeholder="例如：考编选岗、入职后家校关系处理、备考焦虑等..."
            placeholder-class="ph-color"
            maxlength="500"
            bindinput="onInput">
  </textarea>
  <view class="word-count">{{questionText.length}}/500</view>
</view>

<!-- 快速选项 -->
<view class="section-title mt-32">设置</view>
<view class="biz-card option-list">
  <view class="option-item">
    <view class="opt-left">
      <text class="opt-title">匿名提问</text>
      <text class="opt-desc">不向导师展示档案姓名；内容和语音仍可能透露身份</text>
    </view>
    <switch color="#2D5683" checked bindchange="onAnonymousChange"></switch>
  </view>
</view>

<view class="price-row">
  <text class="price-label">模拟问诊额度</text>
  <view class="price-detail">
    <text class="price-symbol">¥</text>
    <text class="price-num">29</text>
    <text class="price-unit">/次</text>
  </view>
</view>

<view class="tip-row"><text class="tip-text">金额为模拟学币，仅演示订单流程；未接入微信支付或真实导师结算。</text></view>

<view class="btn-biz btn-primary submit-btn" bindtap="submitQuestion">提交问诊</view>
</view>

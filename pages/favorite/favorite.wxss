.page-container { padding: 32rpx 32rpx 80rpx; }

.page-header { margin-bottom: 24rpx; }
.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-1);
  display: block;
  letter-spacing: 2rpx;
}
.page-sub {
  font-size: 24rpx;
  color: var(--text-3);
  margin-top: 6rpx;
  letter-spacing: 1rpx;
}

.fav-list { display: flex; flex-direction: column; gap: 16rpx; }
.fav-card {
  display: flex;
  align-items: center;
  padding: 24rpx;
}
.fav-card:active { background: var(--primary-soft); }
.f-avatar {
  width: 92rpx;
  height: 92rpx;
  border-radius: 18rpx;
  font-size: 36rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
  font-family: 'STSong','SimSun',serif;
}
.f-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.f-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-1);
  margin-bottom: 6rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.f-desc {
  font-size: 24rpx;
  color: var(--text-3);
}
.btn-cancel {
  font-size: 22rpx;
  color: var(--text-2);
  border: 1rpx solid var(--border);
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  flex-shrink: 0;
  margin-left: 12rpx;
}
.btn-cancel:active {
  background: var(--primary-soft);
  border-color: var(--primary);
  color: var(--primary);
}

/* 空 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 0;
}
.empty-mark {
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  background: var(--accent-light);
  color: var(--accent-dark);
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  font-family: 'STSong','SimSun',serif;
}
.empty-title {
  font-size: 28rpx;
  color: var(--text-1);
  font-weight: 600;
  margin-bottom: 8rpx;
}
.empty-sub {
  font-size: 22rpx;
  color: var(--text-3);
}

<view class="page-container">

  <view class="page-header">
    <text class="page-title">我的收藏</text>
    <text class="page-sub">演示版暂无持久化收藏</text>
  </view>

  <view class="empty-state" wx:if="{{favorites.length === 0}}">
    <view class="empty-mark">藏</view>
    <text class="empty-title">还没有收藏</text>
    <text class="empty-sub">收藏功能尚未接入云端，不展示虚构记录</text>
  </view>

  <view class="fav-list" wx:else>
    <view class="biz-card fav-card" wx:for="{{favorites}}" wx:key="id" bindtap="goItem" data-type="{{item.type}}">
      <view class="text-badge f-avatar {{item.theme}}">{{item.char}}</view>
      <view class="f-info">
        <text class="f-name">{{item.name}}</text>
        <text class="f-desc">{{item.desc}}</text>
      </view>
      <view class="btn-cancel" catchtap="cancelFav" data-id="{{item.id}}">取消</view>
    </view>
  </view>
</view>

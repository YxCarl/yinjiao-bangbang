.page-container { background: #F5F6FA; min-height: 100vh; padding-bottom: 40rpx; }

.help-header {
  background: linear-gradient(135deg, #2D5683 0%, #3868A0 100%);
  padding: 56rpx 32rpx;
  color: #FFF;
}
.hh-title { font-size: 38rpx; font-weight: 700; display: block; margin-bottom: 8rpx; }
.hh-sub { font-size: 24rpx; color: rgba(255,255,255,0.65); }

.guide-list { padding: 24rpx 32rpx; display: flex; flex-direction: column; gap: 16rpx; }
.guide-item { padding: 28rpx; }
.gi-row { display: flex; align-items: flex-start; }
.gi-icon { width: 72rpx; height: 72rpx; border-radius: 18rpx; font-size: 28rpx; margin-right: 20rpx; flex-shrink: 0; }
.gi-body { flex: 1; }
.gi-title { font-size: 30rpx; font-weight: 700; color: var(--text-1); display: block; margin-bottom: 10rpx; }
.gi-desc { font-size: 26rpx; color: var(--text-2); line-height: 1.7; }

.help-tips { padding: 0 32rpx 32rpx; }
.help-tips .section-title { margin-bottom: 16rpx; }
.tip-item { padding: 24rpx 28rpx; margin-bottom: 12rpx; }
.tip-q { font-size: 28rpx; font-weight: 600; color: var(--primary); display: block; margin-bottom: 10rpx; }
.tip-a { font-size: 26rpx; color: var(--text-2); line-height: 1.7; }

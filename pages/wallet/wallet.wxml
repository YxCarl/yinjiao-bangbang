<view class="page-container">

<view class="page-header">
  <text class="page-title">学币钱包（演示）</text>
  <text class="page-sub">未接入真实支付、充值或结算</text>
</view>

<!-- 余额卡 -->
<view class="balance-card">
  <view class="balance-deco"></view>
  <text class="b-title">模拟余额（无现金价值）</text>
  <text class="b-amount">{{balance}}</text>
  <view class="b-tag-row">
    <text class="b-tag">仅用于测试订单流程</text>
  </view>
</view>

<view class="section-title mt-32">示例套餐（不可购买）</view>

<view class="recharge-grid">
  <view class="r-item {{selectedIndex === index ? 'active' : ''}}"
        wx:for="{{rechargeOptions}}" wx:key="index"
        bindtap="selectOption" data-index="{{index}}">
    <text class="r-price">¥{{item.price}}</text>
    <view class="r-give chip-accent chip" wx:if="{{item.give > 0}}">赠 ¥{{item.give}}</view>
    <view class="r-give chip-muted chip" wx:else>无赠送</view>
    <view class="check-icon" wx:if="{{selectedIndex === index}}">✓</view>
  </view>
</view>

<view class="biz-card pay-channel mt-32">
  <view class="form-item">
    <text class="label">支付状态</text>
    <view class="pay-method">
      <view class="text-badge pay-icon badge-success">微</view>
      <text class="pay-name">未接入微信支付</text>
    </view>
  </view>
</view>

<view class="btn-biz btn-primary submit-btn" bindtap="payRecharge">充值不可用（演示）</view>
<view class="tips">不会扣款、创建充值订单或修改云端余额。</view>
</view>

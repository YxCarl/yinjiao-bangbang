/* ============================================
   师傅在吗 — 全局设计系统
   风格：水墨商务 (Ink Business)
   主色：深靛蓝 (#2D5683) · 典雅金 (#C8924E)
   ============================================ */

   page {
    background-color: #F5F6FA;
    font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', 'Segoe UI', sans-serif;
    color: #1A2236;
    font-size: 28rpx;
    line-height: 1.5;

    /* 主色 */
    --primary: #2D5683;
    --primary-dark: #1F3D5C;
    --primary-light: #EAF1F8;
    --primary-soft: #F4F7FB;

    /* 强调色 */
    --accent: #C8924E;
    --accent-dark: #A87532;
    --accent-light: #FBF3E5;

    /* 中性色 */
    --bg: #F5F6FA;
    --surface: #FFFFFF;
    --text-1: #1A2236;
    --text-2: #4A5570;
    --text-3: #8A92A6;
    --text-4: #B8BECF;
    --border: #E8EBF2;
    --divider: #F0F2F7;

    /* 状态色 */
    --success: #2E9E5F;
    --warning: #D78A2E;
    --danger: #D14040;
    --info: #4A90E2;
  }

  view, text, input, textarea, picker {
    box-sizing: border-box;
  }

  /* ============ 卡片 ============ */
  .biz-card {
    background-color: #FFFFFF;
    border-radius: 16rpx;
    padding: 32rpx;
    box-sizing: border-box;
    box-shadow: 0 2rpx 12rpx rgba(29, 54, 88, 0.04);
    border: 1rpx solid rgba(232, 235, 242, 0.7);
  }

  .biz-card-flat {
    background-color: #FFFFFF;
    border-radius: 16rpx;
    padding: 32rpx;
    border: 1rpx solid var(--border);
  }

  /* ============ 按钮 ============ */
  .btn-biz {
    border-radius: 12rpx;
    font-size: 30rpx;
    font-weight: 500;
    text-align: center;
    padding: 24rpx 0;
    transition: all 0.18s ease;
    letter-spacing: 1rpx;
    line-height: 1.2;
  }
  .btn-biz:active { transform: scale(0.98); opacity: 0.92; }

  .btn-primary {
    background: linear-gradient(135deg, #2D5683 0%, #1F3D5C 100%);
    color: #FFFFFF;
    box-shadow: 0 8rpx 20rpx rgba(45, 86, 131, 0.22);
  }
  .btn-outline {
    background-color: #FFFFFF;
    color: var(--primary);
    border: 2rpx solid var(--primary);
  }
  .btn-ghost {
    background-color: var(--primary-light);
    color: var(--primary);
  }
  .btn-accent {
    background: linear-gradient(135deg, #D9A663 0%, #C8924E 100%);
    color: #FFFFFF;
    box-shadow: 0 8rpx 20rpx rgba(200, 146, 78, 0.22);
  }
  .btn-disabled {
    background-color: #E8EBF2;
    color: #B8BECF;
  }

  /* ============ 文字徽章/头像 ============ */
  .text-badge {
    display: flex;
    justify-content: center;
    align-items: center;
    font-weight: 600;
    color: #FFFFFF;
    letter-spacing: 0;
  }

  /* 几何徽章主题 */
  .badge-primary { background: linear-gradient(135deg, #3868A0 0%, #2D5683 100%); }
  .badge-accent  { background: linear-gradient(135deg, #D9A663 0%, #C8924E 100%); }
  .badge-info    { background: linear-gradient(135deg, #5BA0E8 0%, #4A90E2 100%); }
  .badge-success { background: linear-gradient(135deg, #4CB97D 0%, #2E9E5F 100%); }
  .badge-muted   { background: linear-gradient(135deg, #B0B7C9 0%, #8A92A6 100%); }
  .badge-ink     { background: linear-gradient(135deg, #4A5570 0%, #2C374D 100%); }

  /* ============ 区块标题 ============ */
  .section-title {
    font-size: 32rpx;
    font-weight: 700;
    color: var(--text-1);
    margin-bottom: 24rpx;
    display: flex;
    align-items: center;
    letter-spacing: 1rpx;
  }
  .section-title::before {
    content: '';
    display: inline-block;
    width: 6rpx;
    height: 28rpx;
    background: linear-gradient(180deg, #2D5683 0%, #C8924E 100%);
    border-radius: 4rpx;
    margin-right: 16rpx;
  }
  .section-title-plain {
    font-size: 32rpx;
    font-weight: 700;
    color: var(--text-1);
    margin-bottom: 24rpx;
    letter-spacing: 1rpx;
  }
  .section-sub {
    font-size: 24rpx;
    color: var(--text-3);
    margin-left: auto;
    font-weight: 400;
  }

  /* ============ 通用辅助类 ============ */
  .flex { display: flex; }
  .flex-center { display: flex; align-items: center; justify-content: center; }
  .flex-between { display: flex; align-items: center; justify-content: space-between; }
  .flex-1 { flex: 1; }
  .text-center { text-align: center; }
  .text-primary { color: var(--primary); }
  .text-accent { color: var(--accent); }
  .text-muted { color: var(--text-3); }
  .text-success { color: var(--success); }
  .text-warning { color: var(--warning); }
  .text-danger { color: var(--danger); }

  .mt-8  { margin-top: 8rpx; }
  .mt-16 { margin-top: 16rpx; }
  .mt-24 { margin-top: 24rpx; }
  .mt-32 { margin-top: 32rpx; }
  .mt-40 { margin-top: 40rpx; }
  .mt-48 { margin-top: 48rpx; }
  .mb-16 { margin-bottom: 16rpx; }
  .mb-24 { margin-bottom: 24rpx; }

  /* ============ 输入框 ============ */
  .input-line {
    width: 100%;
    font-size: 30rpx;
    color: var(--text-1);
    padding: 24rpx 0;
    border-bottom: 2rpx solid var(--border);
  }
  .ph-color { color: var(--text-4); }

  /* ============ Tag ============ */
  .chip {
    display: inline-flex;
    align-items: center;
    padding: 6rpx 16rpx;
    border-radius: 8rpx;
    font-size: 22rpx;
    font-weight: 500;
    background: var(--primary-light);
    color: var(--primary);
    letter-spacing: 1rpx;
  }
  .chip-accent  { background: var(--accent-light); color: var(--accent-dark); }
  .chip-success { background: #E5F4EC; color: var(--success); }
  .chip-warning { background: #FBEFDB; color: var(--warning); }
  .chip-info    { background: #EAF2FB; color: var(--info); }
  .chip-muted   { background: #F0F2F7; color: var(--text-2); }

  /* ============ 分割线 ============ */
  .hr-soft {
    height: 1rpx;
    background: var(--divider);
    margin: 24rpx 0;
  }

  /* ============ 空状态 ============ */
  .empty-tip {
    text-align: center;
    color: var(--text-3);
    font-size: 26rpx;
    padding: 120rpx 0;
  }

  /* ============ 列表项 ============ */
  .list-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 32rpx 0;
    border-bottom: 1rpx solid var(--divider);
  }
  .list-row:last-child { border-bottom: none; }
  .list-row:active { opacity: 0.6; }

  /* ============ 导师端底部导航 ============ */
  .mentor-tabbar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 200;
    display: flex;
    background: #FFFFFF;
    border-top: 1rpx solid var(--border);
    padding: 12rpx 0 0;
    padding-bottom: env(safe-area-inset-bottom);
    box-shadow: 0 -4rpx 16rpx rgba(29, 54, 88, 0.04);
  }
  .mentor-tab {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 8rpx 0 14rpx;
    position: relative;
  }
  .mentor-tab:active { opacity: 0.6; }
  .mt-icon {
    width: 52rpx;
    height: 52rpx;
    border-radius: 14rpx;
    background: #F0F2F7;
    color: var(--text-3);
    font-size: 24rpx;
    font-weight: 600;
    font-family: 'STSong', 'SimSun', serif;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 6rpx;
    transition: all 0.18s;
  }
  .mt-label {
    font-size: 22rpx;
    color: var(--text-3);
    letter-spacing: 1rpx;
    transition: color 0.18s;
  }
  .mt-active .mt-icon {
    background: linear-gradient(135deg, #D9A663 0%, #C8924E 100%);
    color: #FFFFFF;
    box-shadow: 0 4rpx 12rpx rgba(200, 146, 78, 0.28);
  }
  .mt-active .mt-label {
    color: var(--accent-dark);
    font-weight: 600;
  }
  .mt-badge {
    position: absolute;
    top: 4rpx;
    right: calc(50% - 30rpx);
    min-width: 26rpx;
    height: 26rpx;
    background: var(--danger);
    color: #FFF;
    font-size: 18rpx;
    font-weight: 600;
    border-radius: 13rpx;
    padding: 0 8rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2rpx solid #FFF;
  }

  /* 导师端页面通用底部留白（为底部 tabbar 让位） */
  .mentor-page-pad { padding-bottom: 160rpx; }
